<!DOCTYPE html>
<!-- saved from url=(0056)https://makup5.github.io/arcanari/equipos/plantilla.html -->
<html lang="es"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
  
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Qhapaq Ñan | Landing del Proyecto</title>

  <style>
    :root{
      --bg:#0b0a10;
      --paper:rgba(255,255,255,.92);
      --stroke:rgba(0,0,0,.10);
      --ink:#1b1b1b;
      --muted:#444;
      --brand:#c0392b;
      --brand2:#7f1d1d;
      --radius:18px;
      --shadow:0 20px 50px rgba(0,0,0,.35);
    }
    *{box-sizing:border-box}
    body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;color:var(--ink);background:var(--bg)}
    a{color:inherit}

    /* Fondo patrón en TODA la página */
    .page{
      min-height:100vh;
      width:100%;
      padding:24px 16px;
      background-image:url('patron.avif');
      background-repeat:repeat;
      background-size:420px auto;
    }

    /* Contenedor centrado */
    .container{max-width:1200px;margin:0 auto;}

    /* Capa de legibilidad */
    .paper{
      background:var(--paper);
      border-radius:var(--radius);
      padding:22px;
      box-shadow:var(--shadow);
      border:1px solid rgba(0,0,0,.06);
    }

    /* Header */
    .header{
      display:flex;
      justify-content:space-between;
      align-items:flex-start;
      gap:16px;
      flex-wrap:wrap;
      border-bottom:4px solid var(--brand);
      padding-bottom:16px;
      margin-bottom:20px;
    }
    .kicker{
      font-size:13px;
      letter-spacing:0.2em;
      font-weight:800;
      color:var(--brand2);
      text-transform:uppercase;
    }
    h1{
      margin:6px 0 0;
      font-size:28px;
      font-weight:900;
      line-height:1.15;
    }
    .subline{font-size:14px;color:var(--muted);margin-top:6px}

    /* QR box */
    .qrbox{
      display:flex;
      gap:12px;
      align-items:center;
      padding:10px;
      border:2px solid var(--brand);
      border-radius:12px;
      background:#fff;
      max-width:360px;
      width:100%;
    }
    .qrbox img{
      width:70px;height:70px;
      object-fit:cover;
      border-radius:10px;
      border:1px solid rgba(0,0,0,.15);
      background:#fff;
      flex:0 0 auto;
    }
    .qrbox b{display:block}
    .qrbox small{display:block;color:#555;margin-top:2px;line-height:1.25}

    /* Sections */
    section{margin-bottom:24px}
    h2{color:var(--brand2);margin:0 0 10px;font-size:18px}
    p{margin:0 0 10px;line-height:1.45}

    /* Project image */
    .heroimg{
      width:100%;
      max-height:600px;
      object-fit:cover;
      border-radius:14px;
      border:3px solid var(--brand);
      display:block;
    }

    /* Gallery button */
    .btn{
      display:inline-block;
      padding:12px 18px;
      background:var(--brand);
      color:#fff;
      font-weight:800;
      text-decoration:none;
      border-radius:10px;
    }
    .btn:active{transform:translateY(1px)}

    /* Team grid */
    .team{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:16px;
    }
    .member{
      display:flex;
      gap:12px;
      align-items:flex-start;
      padding:14px;
      border:2px solid var(--brand);
      border-radius:14px;
      background:#fff;
    }
    .member img{
      width:80px;height:80px;
      object-fit:cover;
      border-radius:10px;
      border:1px solid rgba(0,0,0,.12);
      flex:0 0 auto;
    }
    .role{font-size:13px;color:#555}
    .member p{font-size:14px;margin-top:6px;margin-bottom:0}

    /* Footer */
    .footer{
      margin-top:28px;
      text-align:center;
      font-size:12px;
      color:#555;
      border-top:2px dashed var(--brand);
      padding-top:12px;
    }

    /* Responsive */
    @media (max-width: 900px){
      h1{font-size:24px}
      .paper{padding:18px}
      .team{grid-template-columns:1fr}
      .qrbox{max-width:100%}
    }
    @media (max-width: 480px){
      .page{padding:16px 12px}
      .paper{padding:16px}
      .kicker{font-size:12px}
      h1{font-size:22px}
      .member img{width:68px;height:68px}
      .qrbox img{width:62px;height:62px}
      .btn{width:100%;text-align:center}
    }
  </style>
</head>

<body>
  <div class="page">
    <div class="container">
      <div class="paper">

        <!-- HEADER -->
        <div class="header">
          <div>
            <div class="kicker">Qhapaq Ñan · Proyecto XR</div>
            <h1>Allichina</h1>
            <div class="subline">AR · VR · Impresión 3D · Packaging</div>
          </div>

          <!-- QR -->
          <div class="qrbox">
            <img src="./Qhapaq Ñan _ Landing del Proyecto_files/qr1.jpg" alt="QR del proyecto">
            <div>
              <b>QR del Packaging</b>
              <small>Escanea para ver la web del proyecto desde tu celular.</small>
            </div>
          </div>
        </div>

        <!-- DESCRIPCIÓN -->
        <section>
          <h2>¿Qué es Allichina?</h2>
          <p>
            Allichina es una experiencia interactiva busca que reconstruir digitalmente sitios del Qhapaq Ñan mediante una aplicaion en realidad aumentada.
            Esta se complementa con Kits fisicos o Mystery Boxes con la representacion fisica de varios tipos de construcciones tradicionales en forma de adornos
          </p>
        </section>

        <!-- FOTO DEL PROYECTO -->
        <section>
          <h2>Foto del proyecto</h2>
          <img src="./Qhapaq Ñan _ Landing del Proyecto_files/photo-1545239351-1141bd82e8a6.png" alt="Foto del proyecto (referencia)" class="heroimg">
        </section>

        <!-- GALERÍA AR -->
        <section>
          <h2>Galería AR</h2>
          <p>Accede a la galería AR del proyecto desde el siguiente enlace:</p>
          <a class="btn" href="../pages/muro_inca" target="_blank" rel="noopener">
            Abrir Galería AR
          </a>
        </section>

        <!-- EQUIPO -->
        <section>
          <h2>Equipo de trabajo</h2>

          <div class="team">

            <!-- Integrante -->
            <div class="member">
              <img src="./Qhapaq Ñan _ Landing del Proyecto_files/photo-1524504388940-b1c1722653e1.jpeg" alt="Integrante (referencia)">
              <div>
                <b>Paulina Herrera</b><br>
                <span class="role">Rol: Interacción AR y VR / Modelado 3D / Documentacion / Conceptualizacion </span>
                <p>Lider de grupo y diseñadora de la expriencia virtual junto con el modelado de los objetos a imrpimir en 3D.</p>
              </div>
            </div>

            <!-- Integrante -->
            <div class="member">
              <img src="./Qhapaq Ñan _ Landing del Proyecto_files/photo-1506794778202-cad84cf45f1d.png" alt="Integrante (referencia)">
              <div>
                <b>Daniela Avila</b><br>
                <span class="role">Rol: VR / Jugabilidad VR / Modelado 3D </span>
                <p>Diseñadora del espacio VR e interacciones AR junto con el modelado de los objetos a imrpimir en 3D</p>
              </div>
            </div>

            <!-- Integrante -->
            <div class="member">
              <img src="./Qhapaq Ñan _ Landing del Proyecto_files/photo-1544723795-3fb6469f5b39.png" alt="Integrante (referencia)">
              <div>
                <b>Juan Diego Amendaño</b><br>
                <span class="role">Rol: Modelado 3D / AR </span>
                <p>Diseñador de interaccion AR junto con el modelado de los objetos a imrpimir en 3D.</p>
              </div>
            </div>

            <!-- Integrante -->
            <div class="member">
              <img src="./Qhapaq Ñan _ Landing del Proyecto_files/photo-1525134479668-1bee5c7c6845.jpeg" alt="Integrante (referencia)">
              <div>
                <b>Paula Vanegas</b><br>
                <span class="role">Rol: UX / Packaging / Analisis financiero / </span>
                <p> Diseño de la identidad de la marca incluyendo empaque e interfaz de la app junto con la proyeccion del emprendimiento a futuro en el mercado.</p>
              </div>
            </div>

          </div>
        </section>

        <!-- FOOTER -->
        <div class="footer">
          Proyecto Integrador · Qhapaq Ñan · Séptimo Ciclo · Diseño Multimedia UPS
        </div>

      </div>
    </div>
  </div>



</body></html>
